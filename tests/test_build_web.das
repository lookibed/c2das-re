options gen2
require dastest/testing_boost public
require strings
require daslib/fio

//! `scripts/build_web.sh`'s refusals (web/ARCHITECTURE.md section 2): each fires before the script's
//! first write, so the `--out` folder stays absent. None needs emscripten or the wasm host: emcc is a
//! script on a PATH of its own, and the hosts are a git repository at another commit and the pin
//! itself, whose daslang links libstdc++.

// runs build_web.sh with `args` under the environment assignments `env`, its stdout and stderr in `out`
def private build_web(env, args : string; var out : string&) : int => run_and_capture(["sh", "-c", "{env} bash scripts/build_web.sh {args} 2>&1"], out, 120.0)

// a folder shaped like a ports checkout's puredoom-readable as far as the script checks it
def private fake_ports(dir : string) {
    mkdir_rec(path_join(dir, "puredoom-readable/processed/doom"))
    fwrite(path_join(dir, "puredoom-readable/processed/doom/doom_main.das"), "")
    fake_quake(dir, true)
    mkdir_rec(path_join(dir, "rust/tests/canonical"))
    fwrite(path_join(dir, "rust/tests/canonical/cases.json"), "\{\"cases\": []\}\n")
}

// quakegeneric's converted entry under `dir`, and its README naming the converting commit when `named`
def private fake_quake(dir : string; named : bool) {
    mkdir_rec(path_join(dir, "quakegeneric/readable/quake_entry/src"))
    fwrite(path_join(dir, "quakegeneric/readable/quake_entry/src/quake_entry.das"), "")
    fwrite(path_join(dir, "quakegeneric/README.md"), named ? "- Generated by c2das-re `v0` (`ef5b1353514aadef0627563fe04c06a3887ac03a`, committed 2026-11-16)\n" : "no commit\n")
}

// a PATH holding the tools the script runs before its emcc check, and an `emcc` printing `version_line`
def private tool_path(t : T?; dir, version_line : string) : string {
    let bin = path_join(dir, "bin")
    mkdir_rec(bin)
    var out : string
    for (tool in ["bash", "sh", "sed", "git", "ldd", "grep", "head", "dirname", "tr", "cut"]) {
        let rc = run_and_capture(["sh", "-c", "ln -sf \"$(command -v {tool})\" {bin}/{tool}"], out, 30.0)
        t |> equal(rc, 0, out)
    }
    if (!empty(version_line)) {
        fwrite(path_join(bin, "emcc"), "#!/bin/sh\necho '{version_line}'\n")
        let rc = run_and_capture(["chmod", "+x", path_join(bin, "emcc")], out, 30.0)
        t |> equal(rc, 0, out)
    }
    return bin
}

[test(description = "build_web.sh refuses a missing or empty ports checkout, a host off the pin, a host without libc++ and another emscripten, before writing")]
def test_build_web_refusals(t : T?) {
    var dir_error : string
    let work = create_temp_directory("c2das_build_web", dir_error)
    t |> equal(dir_error, "")
    let out_dir = path_join(work, "out")
    let ports = path_join(work, "ports")
    fake_ports(ports)
    t |> run("no --ports") @(t : T?) {
        var out : string
        let rc = build_web("", "--out {out_dir}", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "--ports <c2das-ports checkout> is required") >= 0, out)
    }
    t |> run("a ports checkout without the converted PureDOOM") @(t : T?) {
        var out : string
        let rc = build_web("", "--ports {work} --out {out_dir}", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "holds no converted PureDOOM") >= 0, out)
    }
    t |> run("no emcc, and an emscripten other than 5.0.7") @(t : T?) {
        var out : string
        let none = tool_path(t, path_join(work, "none"), "")
        let rc_none = build_web("PATH={none}", "--ports {ports} --rust {ports}/rust --out {out_dir}", out)
        t |> equal(rc_none, 1, out)
        t |> success(find(out, "emcc is not on PATH") >= 0, out)
        let other = tool_path(t, path_join(work, "other"), "emcc (Emscripten gcc/clang-like replacement + linker emulating GNU ld) 9.9.9 (deadbeef)")
        let rc = build_web("PATH={other}", "--ports {ports} --rust {ports}/rust --out {out_dir}", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "is not emscripten 5.0.7") >= 0, out)
    }
    let pinned = tool_path(t, path_join(work, "pinned"), "emcc (Emscripten gcc/clang-like replacement + linker emulating GNU ld) 5.0.7 (263db4cffa6f9fc2ec514a70abac81362ea41849)")
    t |> run("a host at another commit than VERSIONS.md's pin") @(t : T?) {
        let host = path_join(work, "host")
        mkdir_rec(host)
        var out : string
        let made = run_and_capture(["sh", "-c", "cd {host} && git init -q && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m x 2>&1"], out, 60.0)
        t |> equal(made, 0, out)
        let rc = build_web("PATH={pinned}", "--ports {ports} --rust {ports}/rust --host {host} --out {out_dir}", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "VERSIONS.md pins") >= 0, out)
    }
    t |> run("the pin itself, whose daslang links libstdc++") @(t : T?) {
        var out : string
        // the arm needs the running daslang at exactly the pin: a later checkout is refused earlier
        let head_rc = run_and_capture(["git", "-C", get_das_root(), "rev-parse", "HEAD"], out, 30.0)
        if (head_rc != 0 || find(fread("VERSIONS.md"), "daScript commit: {strip(out)}") < 0) {
            t |> skip("the running daslang is not at VERSIONS.md's pin")
            return
        }
        let rc = build_web("PATH={pinned}", "--ports {ports} --rust {ports}/rust --host {get_das_root()} --out {out_dir}", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "not a wasm host") >= 0, out)
    }
    t |> success(!fexist(out_dir), "no refusal created the --out folder")
    rmdir_rec(work)
}

// runs `cmd` in a shell, its stdout and stderr in `out`
def private sh(cmd : string; var out : string&) : int => run_and_capture(["sh", "-c", "{cmd} 2>&1"], out, 60.0)

// a built site as the script lays it out, its build.json naming `c2das` and `ports`
def private fake_site(dir, c2das, ports : string) {
    mkdir_rec(path_join(dir, "puredoom"))
    fwrite(path_join(dir, "index.html"), "<p>demos</p>\n")
    fwrite(path_join(dir, "puredoom/doom.html"), "<p>doom</p>\n")
    fwrite(path_join(dir, "puredoom/build.json"), "\{\"c2das_re\": \"{c2das}\", \"ports\": \"{ports}\", \"converted_by\": \"deee3209ce\", \"daslang\": \"2decba91d5\", \"emscripten\": \"5.0.7\"\}\n")
}

// a git checkout at `dir` on `branch`, one commit holding a file `stale.txt`
def private fake_checkout(t : T?; dir, branch : string) {
    var out : string
    let rc = sh("git init -q -b '{branch}' '{dir}' && cd '{dir}' && echo old > stale.txt && git add stale.txt && git -c user.name=t -c user.email=t@t commit -q -m old", out)
    t |> equal(rc, 0, out)
}

[test(description = "build_web.sh --pages refuses a wrong checkout, a dirty or data-carrying site, and else replaces the checkout's top with the site, the workflow and the README")]
def test_build_web_pages(t : T?) {
    var dir_error : string
    let work = create_temp_directory("c2das_build_web_pages", dir_error)
    t |> equal(dir_error, "")
    let pages = path_join(work, "pages")
    fake_checkout(t, pages, "gh-pages")
    let site = path_join(work, "site")
    fake_site(site, "1111111111", "2222222222")
    t |> run("--commit without --pages") @(t : T?) {
        var out : string
        let rc = build_web("", "--from '{site}' --commit", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "there is none") >= 0, out)
    }
    t |> run("--pages that is no checkout, below the top of one, or on another branch") @(t : T?) {
        var out : string
        let plain = path_join(work, "plain")
        mkdir_rec(plain)
        let rc_plain = build_web("", "--from '{site}' --pages '{plain}'", out)
        t |> equal(rc_plain, 1, out)
        t |> success(find(out, "is not a git checkout") >= 0, out)
        let below = path_join(pages, "sub")
        mkdir_rec(below)
        let rc_below = build_web("", "--from '{site}' --pages '{below}'", out)
        t |> equal(rc_below, 1, out)
        t |> success(find(out, "is not the top of its checkout") >= 0, out)
        rmdir_rec(below)
        let main_branch = path_join(work, "main")
        fake_checkout(t, main_branch, "main")
        let rc_main = build_web("", "--from '{site}' --pages '{main_branch}'", out)
        t |> equal(rc_main, 1, out)
        t |> success(find(out, "is not on the gh-pages branch") >= 0, out)
    }
    t |> run("--from a folder that is no built site") @(t : T?) {
        var out : string
        let rc = build_web("", "--from '{work}' --pages '{pages}'", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "holds no built site") >= 0, out)
    }
    t |> run("--commit of a site built from a tree with changes") @(t : T?) {
        let dirty = path_join(work, "dirty")
        fake_site(dirty, "1111111111-dirty", "2222222222")
        var out : string
        let rc = build_web("", "--from '{dirty}' --pages '{pages}' --commit", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "names a tree with changes") >= 0, out)
        t |> success(fexist(path_join(pages, "stale.txt")), "the refusal wrote nothing")
    }
    t |> run("a site that holds a WAD") @(t : T?) {
        let data = path_join(work, "data")
        fake_site(data, "1111111111", "2222222222")
        fwrite(path_join(data, "puredoom/freedoom2.wad"), "IWAD")
        var out : string
        let rc = build_web("", "--from '{data}' --pages '{pages}' --commit", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "holds game data") >= 0, out)
        t |> success(fexist(path_join(pages, "stale.txt")), "the refusal wrote nothing")
    }
    t |> run("a clean site: the checkout's top replaced and committed, a second run commits nothing") @(t : T?) {
        var out : string
        let rc = build_web("", "--from '{site}' --pages '{pages}' --commit", out)
        t |> equal(rc, 0, out)
        t |> success(!fexist(path_join(pages, "stale.txt")), "the old top is gone")
        t |> success(fexist(path_join(pages, "puredoom/doom.html")), "the site is copied")
        t |> success(fexist(path_join(pages, ".github/workflows/pages.yml")), "the deploy workflow is there")
        let readme = fread(path_join(pages, "README.md"))
        t |> success(find(readme, "c2das-ports 2222222222") >= 0 && find(readme, "c2das-re 1111111111") >= 0, readme)
        let log_rc = sh("git -C '{pages}' log -1 --format=%s", out)
        t |> equal(log_rc, 0, out)
        t |> equal(strip(out), "site: c2das-re 1111111111, c2das-ports 2222222222, daScript 2decba91d5")
        let again = build_web("", "--from '{site}' --pages '{pages}' --commit", out)
        t |> equal(again, 0, out)
        t |> success(find(out, "already holds this site") >= 0, out)
        t |> success(find(readme, "C baseline") < 0, "a site without the C build gets no baseline line")
    }
    rmdir_rec(work)
}

[test(description = "build_web.sh --pages names the C baseline and its PureDOOM commit in the README when the site has it")]
def test_build_web_pages_baseline(t : T?) {
    var dir_error : string
    let work = create_temp_directory("c2das_build_web_baseline", dir_error)
    t |> equal(dir_error, "")
    let pages = path_join(work, "pages")
    fake_checkout(t, pages, "gh-pages")
    t |> run("a site with the C baseline names it and its PureDOOM commit in the README") @(t : T?) {
        let with_c = path_join(work, "with_c")
        fake_site(with_c, "3333333333", "2222222222")
        fwrite(path_join(with_c, "puredoom/build.json"), "\{\"c2das_re\": \"3333333333\", \"ports\": \"2222222222\", \"converted_by\": \"deee3209ce\", \"daslang\": \"2decba91d5\", \"emscripten\": \"5.0.7\", \"puredoom\": \"355cfbd16f\"\}\n")
        fwrite(path_join(with_c, "puredoom/doom_c.html"), "<p>c</p>\n")
        var out : string
        let rc = build_web("", "--from '{with_c}' --pages '{pages}' --commit", out)
        t |> equal(rc, 0, out)
        let readme = fread(path_join(pages, "README.md"))
        t |> success(find(readme, "C baseline") >= 0 && find(readme, "PureDOOM 355cfbd16f") >= 0, readme)
    }
    rmdir_rec(work)
}

// a stand-in repository at `dir` holding build_web.sh, a VERSIONS.md pinning `pin`, and the sidecar
// text `sidecar`; `fetch` is the body of its doom/fetch.sh, none when empty
def private stand_in_repo(t : T?; dir, pin, sidecar, fetch : string) {
    mkdir_rec(path_join(dir, "scripts"))
    mkdir_rec(path_join(dir, "doom"))
    var out : string
    let rc = run_and_capture(["cp", "scripts/build_web.sh", path_join(dir, "scripts/build_web.sh")], out, 30.0)
    t |> equal(rc, 0, out)
    fwrite(path_join(dir, "VERSIONS.md"), "daScript commit: {pin} (a stand-in)\n")
    fwrite(path_join(dir, "doom/doom.c2das"), sidecar)
    if (!empty(fetch)) {
        fwrite(path_join(dir, "doom/fetch.sh"), fetch)
    }
}

// a stand-in wasm host at `dir`: a git checkout whose bin/daslang links libc++ (a small program
// built with -stdlib=libc++); its commit, "" where no compiler builds against libc++
def private stand_in_host(t : T?; dir : string; gate : bool) : string {
    mkdir_rec(path_join(dir, "bin"))
    var out : string
    fwrite(path_join(dir, "probe.cpp"), "#include <string>\nint main() \{ return std::string(\"x\").size() == 1 ? 0 : 1; \}\n")
    for (cxx in ["clang++-18", "clang++"]) {
        if (executable_on_path(cxx) && run_and_capture([cxx, "-stdlib=libc++", "-o", path_join(dir, "bin/daslang"), path_join(dir, "probe.cpp")], out, 120.0) == 0) {
            break
        }
    }
    if (!fexist(path_join(dir, "bin/daslang"))) {
        return ""
    }
    if (gate) {
        mkdir_rec(path_join(dir, "site/files"))
        fwrite(path_join(dir, "site/files/wasm-gate.js"), "window.dasWasmGate = 1;\n")
    }
    let rc = run_and_capture(["sh", "-c", "cd '{dir}' && git init -q && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m x && git rev-parse HEAD"], out, 60.0)
    t |> equal(rc, 0, out)
    return strip(out)
}

[test(description = "build_web.sh refuses a sidecar without defines, a host without the browser gate and a failed PureDOOM fetch, before writing")]
def test_build_web_baseline_refusals(t : T?) {
    var dir_error : string
    let work = create_temp_directory("c2das_build_web_c", dir_error)
    t |> equal(dir_error, "")
    let out_dir = path_join(work, "out")
    let ports = path_join(work, "ports")
    fake_ports(ports)
    let sidecar = "\{\n    \"defines\": [\"DOOM_TIC_CHECKSUM\"]\n\}\n"
    t |> run("a sidecar that names no defines") @(t : T?) {
        let repo = path_join(work, "repo_nodefines")
        stand_in_repo(t, repo, "0000000000000000000000000000000000000000", "\{\}\n", "")
        var out : string
        let rc = run_and_capture(["sh", "-c", "bash '{repo}/scripts/build_web.sh' --ports '{ports}' --rust '{ports}/rust' --out '{out_dir}' 2>&1"], out, 120.0)
        t |> equal(rc, 1, out)
        t |> success(find(out, "names no defines") >= 0, out)
    }
    let pinned = tool_path(t, path_join(work, "pinned"), "emcc (Emscripten gcc/clang-like replacement + linker emulating GNU ld) 5.0.7 (263db4cffa6f9fc2ec514a70abac81362ea41849)")
    t |> run("a host without the browser gate, then a fetch that fails") @(t : T?) {
        let bare = path_join(work, "host_bare")
        let bare_pin = stand_in_host(t, bare, false)
        if (empty(bare_pin)) {
            t |> skip("no compiler builds against libc++ here, so no stand-in wasm host")
            return
        }
        let repo = path_join(work, "repo_gate")
        stand_in_repo(t, repo, bare_pin, sidecar, "")
        var out : string
        let rc = run_and_capture(["sh", "-c", "PATH='{pinned}' bash '{repo}/scripts/build_web.sh' --ports '{ports}' --rust '{ports}/rust' --host '{bare}' --out '{out_dir}' 2>&1"], out, 120.0)
        t |> equal(rc, 1, out)
        t |> success(find(out, "no browser gate") >= 0, out)
        let gated = path_join(work, "host_gated")
        let gated_pin = stand_in_host(t, gated, true)
        let repo_fetch = path_join(work, "repo_fetch")
        stand_in_repo(t, repo_fetch, gated_pin, sidecar, "exit 1\n")
        let rc_fetch = run_and_capture(["sh", "-c", "PATH='{pinned}' bash '{repo_fetch}/scripts/build_web.sh' --ports '{ports}' --rust '{ports}/rust' --host '{gated}' --out '{out_dir}' 2>&1"], out, 120.0)
        t |> equal(rc_fetch, 1, out)
        t |> success(find(out, "could not fetch PureDOOM") >= 0, out)
    }
    t |> success(!fexist(out_dir), "no refusal created the --out folder")
    rmdir_rec(work)
}

[test(description = "build_web.sh refuses a ports checkout without quakegeneric, no --rust, a Rust checkout without cases and a README naming no converting commit, before writing")]
def test_build_web_quake_refusals(t : T?) {
    var dir_error : string
    let work = create_temp_directory("c2das_build_web_q", dir_error)
    t |> equal(dir_error, "")
    let out_dir = path_join(work, "out")
    let ports = path_join(work, "ports")
    fake_ports(ports)
    t |> run("no quakegeneric in the ports checkout") @(t : T?) {
        let bare = path_join(work, "bare")
        mkdir_rec(path_join(bare, "puredoom-readable/processed/doom"))
        fwrite(path_join(bare, "puredoom-readable/processed/doom/doom_main.das"), "")
        var out : string
        let rc = build_web("", "--ports {bare} --rust {ports}/rust --out {out_dir}", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "holds no converted quakegeneric") >= 0, out)
    }
    t |> run("no --rust, and a Rust checkout without its cases") @(t : T?) {
        var out : string
        let rc = build_web("", "--ports {ports} --out {out_dir}", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "--rust <lookibed/c2das checkout> is required") >= 0, out)
        let rc_cases = build_web("", "--ports {ports} --rust {work} --out {out_dir}", out)
        t |> equal(rc_cases, 1, out)
        t |> success(find(out, "no Rust repository's cases there") >= 0, out)
    }
    t |> run("a quakegeneric README naming no converting commit") @(t : T?) {
        let unnamed = path_join(work, "unnamed")
        mkdir_rec(path_join(unnamed, "puredoom-readable/processed/doom"))
        fwrite(path_join(unnamed, "puredoom-readable/processed/doom/doom_main.das"), "")
        fake_quake(unnamed, false)
        var out : string
        let rc = build_web("", "--ports {unnamed} --rust {ports}/rust --out {out_dir}", out)
        t |> equal(rc, 1, out)
        t |> success(find(out, "names no converting commit") >= 0, out)
    }
    t |> success(!fexist(out_dir), "no refusal created the --out folder")
    rmdir_rec(work)
}

