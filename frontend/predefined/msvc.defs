# The predefined macros of the `msvc` dialect (frontend/ARCHITECTURE.md section 3).
# One entry a line: NAME, NAME=value or NAME(params)=value.

# the language: ISO C17 with GNU extensions, clang's default when it is given no -std;
# __STDC_NO_VLA__ is the converter's own statement, the one name here clang does not define
__STDC_EMBED_EMPTY__=2
__STDC_EMBED_FOUND__=1
__STDC_EMBED_NOT_FOUND__=0
__STDC_HOSTED__=1
__STDC_NO_THREADS__=1
__STDC_NO_VLA__=1
__STDC_UTF_16__=1
__STDC_UTF_32__=1
__STDC_VERSION__=201710L

# the platform
_CHAR_UNSIGNED=1
_INTEGRAL_MAX_BITS=64
_M_AMD64=100
_M_X64=100
_WIN32=1
_WIN64=1
__amd64=1
__amd64__=1
__x86_64=1
__x86_64__=1

# the data model and the byte order
__BYTE_ORDER__=__ORDER_LITTLE_ENDIAN__
__LITTLE_ENDIAN__=1
__ORDER_BIG_ENDIAN__=4321
__ORDER_LITTLE_ENDIAN__=1234
__ORDER_PDP_ENDIAN__=3412

