options gen2
require dastest/testing_boost public
require strings
require daslib/strings_boost
require ../puredoom.das

//! PureDOOM's texts over fixed harness output: the sync verdicts and their record, the patch notes
//! and the README.

let SYNC_RUN = "[I] doom: converting\ninterp demo2 on freedoom2.wad: 1863 tics in sync against doom/ref/freedoom2_demo2.log\ninterp demo2 on freedoom2.wad: exit 0\ninterp demo2 on freedoom2.wad: 0.190 s per 35 tics (1863 tics in 10.1 s)\n"
let DESYNC_RUN = "jit demo1 on freedoom2.wad: desync after 254 tics in sync on fb: tic=255 cs=1 fb=2 expected tic=255 cs=1 fb=3 against doom/ref/freedoom2_demo1.log\njit demo1 on freedoom2.wad: exit 0\n"
let PATCH = "c2das-re fix of PureDOOM's ticcmd_t, applied by doom/fetch.sh after 0001.\n\nCopyright (C) 2026 the c2das-re authors. This patch modifies PureDOOM.\n\n- d_ticcmd.h: ticcmd_t's moves are `signed char`,\n  as in Chocolate Doom.\n- second item.\n\ndiff --git a/x b/x\n- removed line\n"

[test]
def test_sync_verdict(t : T?) {
    t |> run("a run in sync: its summary, no seconds") @(t : T?) {
        t |> equal(sync_verdict("interp", 2, 0, SYNC_RUN), "1863 tics in sync")
    }
    t |> run("a desync fails with the harness's summary") @(t : T?) {
        t |> equal(sync_verdict("jit", 1, 1, DESYNC_RUN), "fails: desync after 254 tics in sync on fb: tic=255 cs=1 fb=2 expected tic=255 cs=1 fb=3")
    }
    t |> run("another tier's or demo's line is no summary: the first reported line and the exit code") @(t : T?) {
        t |> equal(sync_verdict("exe", 2, 3, SYNC_RUN), "fails: exit 3: interp demo2 on freedoom2.wad: 1863 tics in sync against doom/ref/freedoom2_demo2.log")
        t |> equal(sync_verdict("exe", 1, 1, "[I] only info\n"), "fails: exit 1")
    }
}

[test]
def test_program_converted(t : T?) {
    t |> run("the program line converts the program whatever the units alone did; a blocked program does not") @(t : T?) {
        t |> success(program_converted("[I] doom: unit: 11 of 63 pass\n[I] doom: program (source): 93 files, 481 partition lines\n"))
        t |> success(!program_converted("[I] doom: unit: 63 of 63 pass\n[I] doom: program (source): emitter: boom\n[I] doom: program (source) blocked by: x\n"))
        t |> success(!program_converted(""))
    }
}

[test]
def test_sync_record(t : T?) {
    t |> run("the record reads back cell for cell; a line without three fields is left out") @(t : T?) {
        let cells <- [SyncCell(tier = "interp", demo = 1, verdict = "2664 tics in sync"), SyncCell(tier = "exe", demo = 3, verdict = "fails: exit 1")]
        let text = sync_record(cells)
        t |> equal(text, "interp\t1\t2664 tics in sync\nexe\t3\tfails: exit 1\n")
        let back <- read_sync(text + "garbage line\n")
        t |> equal(length(back), 2)
        t |> equal(back[1].tier, "exe")
        t |> equal(back[1].demo, 3)
        t |> equal(back[1].verdict, "fails: exit 1")
    }
}

[test]
def test_patch_note(t : T?) {
    t |> run("the first line and the items joined, the copyright paragraph and the diff left out") @(t : T?) {
        t |> equal(patch_note(PATCH), "c2das-re fix of PureDOOM's ticcmd_t, applied by doom/fetch.sh after 0001. d_ticcmd.h: ticcmd_t's moves are `signed char`, as in Chocolate Doom. second item.")
    }
}

[test]
def test_readme(t : T?) {
    t |> run("the README: the pin, each patch, the variants, a sync table per variant with a missing cell, no wad shipped, the performance text last") @(t : T?) {
        var inscope r = PureDoomReadme(pin = "355cfbd", freedoom = "0.13.0 (the release)", generation = "Generated by c2das-re `v1` (`abc`, committed 2026-11-10)", command = "scripts/publish_ports.sh --program puredoom", fps_text = "FPS TABLE\n", variants_text = "VARIANTS TABLE\n")
        r.patches |> push((name = "0001-a.patch", note = "the checksum"))
        r.syncs <- [(name = "readable", cells <- [SyncCell(tier = "interp", demo = 1, verdict = "2664 tics in sync"), SyncCell(tier = "exe", demo = 3, verdict = "fails: exit 1")]), (name = "fast", cells <- [SyncCell(tier = "jit", demo = 2, verdict = "5444 tics in sync")])]
        let text = puredoom_readme_text(r)
        t |> success(text |> contains("## Variants\n\nVARIANTS TABLE\n\n## Files\n\n- `readable/doom/` - the readable variant's conversion"), text)
        t |> success(text |> contains("- `fast/doom.c2das` - the sidecar the fast variant was converted under, `fast/variant.json`"), text)
        t |> success(text |> contains("-jit fast/doom/doom_main.das -- -timedemo demo1"), text)
        t |> success(text |> contains("`readable/`:\n\n| Tier "), text)
        t |> success(!(text |> contains("| fast/`:")) && text |> contains("\n`fast/`:\n\n| Tier "), text)
        t |> success(text |> contains("| jit    | not run | 5444 tics in sync | not run |"), text)
        t |> success(text |> contains("PureDOOM) (Daivuk's embeddable Doom, GPL-2) at `355cfbd`"), text)
        t |> success(text |> contains("  - `0001-a.patch` - the checksum\n"), text)
        t |> success(text |> contains("- Generated by c2das-re `v1` (`abc`, committed 2026-11-10)\n"), text)
        t |> success(text |> contains("No WAD is published here. The demos run on `freedoom2.wad` of Freedoom (BSD), 0.13.0 (the release)."), text)
        t |> success(text |> contains("| interp | 2664 tics in sync | not run | not run       |"), text)
        t |> success(text |> contains("| exe    | not run           | not run | fails: exit 1 |"), text)
        t |> success(text |> ends_with("## Performance\n\nFPS TABLE\n"), text)
    }
}
