def private exec_backjump__kernel_run {
    var acc : int = 0
    var r : int
    for (i in range(64)) {
        exec_backjump__code[i] = uint8(30 + i * 7 % 18)
    }
    {
        r = 0
        while (r < c_volatile_load(exec_backjump__rounds)) {
            acc = exec_backjump__run(acc + r)
            r++
        }
    }
    exec_backjump__result = acc
}

def private exec_backjump__kernel_result : int {
    return exec_backjump__result
}

[c_function]
def c_main : int {
    var budget : double = 0.5lf
    var n : int64 = int64(1)
    var total : double = 0.0lf
    {
        while (true) {
            var t0 : int64 = crt::c_monotonic_ns()
            for (i in range64(n)) {
                exec_backjump__kernel_run()
                c_volatile_store(exec_backjump__c2das_sink, exec_backjump__kernel_result())
            }
            total = double(crt::c_monotonic_ns() - t0) / 1000000000.0lf
            if (total >= budget || n >= 1000000000l) {
                break
            }
            var per : double = total / double(n) > 1e-09lf ? total / double(n) : 1e-09lf
            var next : int64 = int64(budget / per * 1.2lf)
            if (next > int64(100) * n) {
                next = int64(100) * n
            }
            if (next < n + int64(1)) {
                next = n + int64(1)
            }
            n = next < 1000000000l ? next : 1000000000l
        }
    }
    printf(reinterpret<uint8?>("%.9f %ld %d\n"), total / double(n), n, exec_backjump__kernel_result())
    return 0
}

[export]
def main : int {
