diff --git a/host.c b/host.c
new file mode 100644
index 0000000..ae58c92
--- /dev/null
+++ b/host.c
@@ -0,0 +1,91 @@
+// c2das-re port: the libc calls c_runtime does not map, as portable C.
+#include "chibicc.h"
+
+char *host_strndup(char *s, size_t n) {
+  size_t len = 0;
+  while (len < n && s[len])
+    len++;
+  char *p = calloc(1, len + 1);
+  memcpy(p, s, len);
+  return p;
+}
+
+// POSIX dirname: modifies `path`.
+char *host_dirname(char *path) {
+  if (!path || !*path)
+    return ".";
+  char *end = path + strlen(path) - 1;
+  while (end > path && *end == '/')
+    end--;
+  while (end > path && *end != '/')
+    end--;
+  if (end == path)
+    return *path == '/' ? "/" : ".";
+  while (end > path && *end == '/')
+    end--;
+  end[1] = '\0';
+  return path;
+}
+
+// POSIX basename: modifies `path`.
+char *host_basename(char *path) {
+  if (!path || !*path)
+    return ".";
+  char *end = path + strlen(path) - 1;
+  while (end > path && *end == '/')
+    *end-- = '\0';
+  char *slash = strrchr(path, '/');
+  if (slash && slash[1])
+    return slash + 1;
+  return path;
+}
+
+char *host_strtok(char *s, char *delim) {
+  static char *next;
+  if (s)
+    next = s;
+  if (!next)
+    return NULL;
+  while (*next && strchr(delim, *next))
+    next++;
+  if (!*next) {
+    next = NULL;
+    return NULL;
+  }
+  char *start = next;
+  while (*next && !strchr(delim, *next))
+    next++;
+  if (*next)
+    *next++ = '\0';
+  else
+    next = NULL;
+  return start;
+}
+
+// The x87 80-bit encoding of `v`: out[0] the mantissa with its explicit integer bit, out[1] the
+// sign and the 15-bit exponent.
+void host_f80_bits(double v, uint64_t *out) {
+  uint64_t bits;
+  memcpy(&bits, &v, 8);
+  uint64_t sign = bits >> 63;
+  int exp = (bits >> 52) & 0x7ff;
+  uint64_t frac = bits & 0xfffffffffffffULL;
+  uint64_t mant = 0;
+  int e = 0;
+  if (exp == 0x7ff) {
+    mant = (1ULL << 63) | (frac << 11);
+    e = 0x7fff;
+  } else if (exp != 0) {
+    mant = (1ULL << 63) | (frac << 11);
+    e = exp - 1023 + 16383;
+  } else if (frac != 0) {
+    mant = frac << 11;
+    e = 1 - 1023 + 16383;
+    while (!(mant >> 63)) {
+      mant <<= 1;
+      e--;
+    }
+  }
+  out[0] = mant;
+  out[1] = (sign << 15) | e;
+}
