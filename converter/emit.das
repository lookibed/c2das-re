options gen2

module emit public

require strings
require daslib/strings_boost
require cir

//! The das emitter: C-IR in, gen2 source text out. Fails closed on any node outside the
//! lowered subset; `error` carries the first such node.

struct Emitter {
    out : string
    depth : int
    error : string
    has_c_main : bool
}

let GENERATED_BANNER = "// generated by c2das - regenerate, never edit"

def private fail(var em : Emitter; what : string; loc : CirLoc) {
    if (empty(em.error)) {
        em.error = "{loc.file}:{loc.line}:{loc.col}: {what}"
    }
}

def private line(var em : Emitter; text : string) {
    em.out += repeat("    ", em.depth) + text + "\n"
}

//! The das spelling of type `t`, or "" with `error` set.
def das_type(var em : Emitter; tu : CirTu; t : int; loc : CirLoc) : string {
    if (t < 0 || t >= length(tu.types)) {
        fail(em, "type index {t} out of range", loc)
        return ""
    }
    let k = tu.types[t].k
    if (k == "void") {
        return "void"
    }
    if (k == "int") {
        if (tu.types[t].spell == "_Bool") {
            return "bool"
        }
        let w = tu.types[t].w
        let base = w == 8 ? "int8" : w == 16 ? "int16" : w == 64 ? "int64" : "int"
        return tu.types[t].is_signed ? base : "u" + base
    }
    if (k == "float") {
        return tu.types[t].w == 32 ? "float" : "double"
    }
    if (k == "ptr") {
        let to = das_type(em, tu, tu.types[t].to, loc)
        return empty(to) ? "" : to + "?"
    }
    fail(em, "type kind `{k}` is not lowered yet", loc)
    return ""
}

def private int_literal(var em : Emitter; tu : CirTu; x : CirExpr; loc : CirLoc) : string {
    let spelled = das_type(em, tu, x.t, loc)
    if (spelled == "int") {
        return x.v
    }
    if (spelled == "uint") {
        return x.v + "u"
    }
    if (spelled == "int64") {
        return x.v + "l"
    }
    if (spelled == "uint64") {
        return x.v + "ul"
    }
    if (spelled == "bool") {
        return x.v != "0" ? "true" : "false"
    }
    return "{spelled}({x.v})"
}

def emit_expr(var em : Emitter; tu : CirTu; x : CirExpr?; loc : CirLoc) : string {
    if (x == null) {
        fail(em, "missing expression", loc)
        return ""
    }
    if (x.e == "int_lit") {
        return int_literal(em, tu, *x, loc)
    }
    if (x.e == "cast") {
        let inner = emit_expr(em, tu, x.a, loc)
        if (x.cast_kind == "LValueToRValue" || x.cast_kind == "NoOp") {
            return inner
        }
        if (x.cast_kind == "IntegralCast") {
            return "{das_type(em, tu, x.t, loc)}({inner})"
        }
        fail(em, "cast `{x.cast_kind}` is not lowered yet", loc)
        return ""
    }
    fail(em, "expression `{x.e}` is not lowered yet", loc)
    return ""
}

def emit_stmt(var em : Emitter; tu : CirTu; st : CirStmt?) {
    if (st == null) {
        return
    }
    if (st.s == "compound") {
        for (child in st.body) {
            emit_stmt(em, tu, child)
        }
    } elif (st.s == "return") {
        if (st.e == null) {
            line(em, "return")
        } else {
            line(em, "return {emit_expr(em, tu, st.e, st.loc)}")
        }
    } else {
        fail(em, "statement `{st.s}` is not lowered yet", st.loc)
    }
}

def private das_func_name(var em : Emitter; d : CirDecl) : string {
    if (d.c_name == "main" && !d.is_static) {
        em.has_c_main = true
        return "c_main"
    }
    return d.name
}

def emit_decl(var em : Emitter; tu : CirTu; d : CirDecl) {
    if (d.k != "func") {
        fail(em, "declaration `{d.k}` is not lowered yet", d.loc)
        return
    }
    if (d.body == null) {
        return
    }
    if (!empty(d.params)) {
        fail(em, "function parameters are not lowered yet", d.loc)
        return
    }
    if (tu.types[d.t].variadic) {
        fail(em, "variadic functions are not lowered yet", d.loc)
        return
    }
    let ret = das_type(em, tu, tu.types[d.t].ret, d.loc)
    let header = "def {d.is_static ? "private " : ""}{das_func_name(em, d)}" + (ret == "void" ? "" : " : {ret}") + " \{"
    line(em, header)
    em.depth++
    emit_stmt(em, tu, d.body)
    em.depth--
    line(em, "\}")
    line(em, "")
}

//! The whole module: banner, options, every declaration, and the `main` wrapper when the C
//! program has one. Empty with `error` set when a node is outside the subset.
def emit_tu(tu : CirTu) : Emitter {
    var em : Emitter
    line(em, GENERATED_BANNER)
    line(em, "options gen2")
    line(em, "options indenting = 4")
    line(em, "")
    for (d in tu.decls) {
        emit_decl(em, tu, *d)
        break if (!empty(em.error))
    }
    if (em.has_c_main) {
        line(em, "[export]")
        line(em, "def main : int \{")
        em.depth++
        line(em, "return c_main()")
        em.depth--
        line(em, "\}")
    }
    return <- em
}
