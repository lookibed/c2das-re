options gen2

module emit public

require strings
require daslib/strings_boost
require crt
require cir

//! The das emitter: C-IR in, gen2 source text out, one pass that spells nodes and lowers the
//! shapes `docs/lowering-examples.md` names as it meets them (statement-ification, the loop
//! flags, the `if` chains). Fails closed on any node outside the lowered subset; `error`
//! carries the first such node.

struct Em {
    text : string
    prec : int
    is_bool : bool
}

struct Emitter {
    out : array<string>
    text : string
    depth : int
    error : string
    has_c_main : bool
    pre : array<string>
    temp_counter : int
    first_counter : int
    for_counter : int
    requires : table<string>
    written : table<string>
    renames : table<string; string>
    functions : table<string>
    unsafe_used : bool
}

let GENERATED_BANNER = "// generated by c2das - regenerate, never edit"

let DAS_KEYWORDS <- {"table", "array", "label", "in", "deref", "addr", "new", "delete", "var", "let", "def", "struct", "class", "enum", "typedef", "return", "yield", "goto", "with", "assume", "unsafe", "try", "recover", "finally", "panic", "static_if", "static_elif", "elif", "cast", "upcast", "reinterpret", "override", "abstract", "sealed", "private", "public", "shared", "where", "expect", "pass", "explicit", "capture", "template", "range", "urange", "range64", "urange64", "block", "function", "lambda", "iterator", "generator", "options", "require", "module", "operator", "true", "false", "null", "string", "int", "uint", "float", "double", "bool", "void", "int8", "uint8", "int16", "uint16", "int64", "uint64", "bitfield", "variant", "tuple", "as", "is", "type", "typeinfo", "sizeof", "typename", "smart_ptr", "invoke", "inscope", "implicit", "const", "static", "match", "generic", "auto", "aka", "defer", "print", "assert", "verify", "debug"}

let PREC_PRIMARY = 14
let PREC_UNARY = 13
let PREC_MUL = 12
let PREC_ADD = 11
let PREC_SHIFT = 10
let PREC_REL = 9
let PREC_EQ = 8
let PREC_BAND = 7
let PREC_BXOR = 6
let PREC_BOR = 5
let PREC_LAND = 4
let PREC_LOR = 3
let PREC_COND = 2

let BIN_SPELLING <- {"add" => "+", "sub" => "-", "mul" => "*", "div" => "/", "rem" => "%", "shl" => "<<", "shr" => ">>", "lt" => "<", "gt" => ">", "le" => "<=", "ge" => ">=", "eq" => "==", "ne" => "!=", "band" => "&", "bor" => "|", "bxor" => "^", "land" => "&&", "lor" => "||"}

let BIN_PREC <- {"add" => 11, "sub" => 11, "mul" => 12, "div" => 12, "rem" => 12, "shl" => 10, "shr" => 10, "lt" => 9, "gt" => 9, "le" => 9, "ge" => 9, "eq" => 8, "ne" => 8, "band" => 7, "bor" => 5, "bxor" => 6, "land" => 4, "lor" => 3}

// C name -> das spelling, and the module it needs: the c_runtime pieces and the crt binds
let LIBC_CALLS <- {"printf" => "printf", "exit" => "c_exit", "abort" => "c_abort", "clock" => "crt::clock", "time" => "crt::time", "rand" => "crt::rand", "srand" => "crt::srand"}

let LIBC_MODULES <- {"printf" => "c_runtime/printf", "exit" => "c_runtime/c_exit", "abort" => "c_runtime/c_exit", "clock" => "crt", "time" => "crt", "rand" => "crt", "srand" => "crt"}

def private fail(var em : Emitter; what : string; loc : CirLoc) {
    if (empty(em.error)) {
        em.error = "{loc.file}:{loc.line}:{loc.col}: {what}"
    }
}

def private line(var em : Emitter; text : string) {
    em.out |> push(repeat("    ", em.depth) + text + "\n")
}

def private flush_pre(var em : Emitter) {
    for (stmt in em.pre) {
        line(em, stmt)
    }
    em.pre |> clear()
}

// statements that run before the statement being emitted, in order
def private hoist(var em : Emitter; stmts : array<string>) {
    em.pre |> push_from(stmts)
}

def private temp_name(var em : Emitter) : string {
    let name = "_t{em.temp_counter}"
    em.temp_counter++
    return name
}

def private das_name(em : Emitter; c_name : string) : string {
    let renamed = em.renames?[c_name] ?? ""
    if (!empty(renamed)) {
        return renamed
    }
    return key_exists(DAS_KEYWORDS, c_name) ? "_c_{c_name}" : c_name
}

def private value(text : string; prec : int) : Em {
    return Em(text = text, prec = prec, is_bool = false)
}

def private truth(text : string; prec : int) : Em {
    return Em(text = text, prec = prec, is_bool = true)
}

def private wrap(e : Em; need : int) : string {
    return e.prec < need ? "({e.text})" : e.text
}

def private kind_of(tu : CirTu; t : int) : string {
    return t >= 0 && t < length(tu.types) ? tu.types[t].k : ""
}

def private is_small_int(tu : CirTu; t : int) : bool {
    return kind_of(tu, t) == "int" && tu.types[t].w < 32 && tu.types[t].spell != "_Bool"
}

def private is_unsigned(tu : CirTu; t : int) : bool {
    return kind_of(tu, t) == "int" && !tu.types[t].is_signed
}

//! The das spelling of type `t`, or "" with `error` set.
def das_type(var em : Emitter; tu : CirTu; t : int; loc : CirLoc) : string {
    if (t < 0 || t >= length(tu.types)) {
        fail(em, "type index {t} out of range", loc)
        return ""
    }
    let k = tu.types[t].k
    if (k == "void") {
        return "void"
    }
    if (k == "int") {
        if (tu.types[t].spell == "_Bool") {
            return "bool"
        }
        let w = tu.types[t].w
        let base = w == 8 ? "int8" : w == 16 ? "int16" : w == 64 ? "int64" : "int"
        return tu.types[t].is_signed ? base : "u" + base
    }
    if (k == "float") {
        return tu.types[t].w == 32 ? "float" : "double"
    }
    if (k == "ptr") {
        let to = das_type(em, tu, tu.types[t].to, loc)
        return empty(to) ? "" : to + "?"
    }
    if (k == "array") {
        let elem = das_type(em, tu, tu.types[t].elem, loc)
        return empty(elem) ? "" : "{elem}[{tu.types[t].count}]"
    }
    fail(em, "type kind `{k}` is not lowered yet", loc)
    return ""
}

// the bool view of a C scalar: a comparison stays one, a pointer tests against null, an
// integer against zero
def private to_bool(e : Em; tu : CirTu; t : int) : Em {
    if (e.is_bool) {
        return e
    }
    let zero = kind_of(tu, t) == "ptr" ? "null" : kind_of(tu, t) == "float" ? (tu.types[t].w == 32 ? "0.0f" : "0.0lf") : "0"
    return truth("{wrap(e, PREC_EQ + 1)} != {zero}", PREC_EQ)
}

// the int view of a C expression das spelled as a bool
def private to_int(e : Em) : Em {
    return e.is_bool ? value("{wrap(e, PREC_COND + 1)} ? 1 : 0", PREC_COND) : e
}

def private literal(var em : Emitter; tu : CirTu; x : CirExpr; loc : CirLoc) : Em {
    let spelled = das_type(em, tu, x.t, loc)
    if (x.e == "float_lit") {
        let text = unsafe(reinterpret<uint8?>(x.v))
        let v = unsafe(crt::strtod(text, null))
        if (spelled == "float") {
            return value("{float(v)}f", PREC_PRIMARY)
        }
        var digits = "{v}"
        if (find(digits, ".") < 0 && find(digits, "e") < 0 && find(digits, "n") < 0) {
            digits += ".0"
        }
        return value(digits + "lf", PREC_PRIMARY)
    }
    let negative = x.v |> starts_with("-")
    let prec = negative ? PREC_UNARY : PREC_PRIMARY
    if (spelled == "int") {
        return value(x.v, prec)
    }
    if (spelled == "uint") {
        return value(x.v + "u", prec)
    }
    if (spelled == "int64") {
        return value(x.v + "l", prec)
    }
    if (spelled == "uint64") {
        return value(x.v + "ul", prec)
    }
    if (spelled == "bool") {
        return value(x.v != "0" ? "true" : "false", PREC_PRIMARY)
    }
    return value("{spelled}({x.v})", PREC_PRIMARY)
}

def private string_literal(var em : Emitter; x : CirExpr; loc : CirLoc) : Em {
    let n = length(x.bytes)
    if (n <= 1) {
        fail(em, "the empty string literal has no das spelling yet (probe-findings F10)", loc)
        return value("", PREC_PRIMARY)
    }
    let text = build_string() $(var w) {
        w |> write("\"")
        for (idx in range(n - 1)) {
            let b = int(x.bytes[idx])
            if (b == 0) {
                fail(em, "a string literal with an interior NUL is not lowered yet", loc)
            } elif (b == '"') {
                w |> write("\\\"")
            } elif (b == '\\') {
                w |> write("\\\\")
            } elif (b == 123) {
                w |> write("\\")
                w |> write("\{")
            } elif (b == 125) {
                w |> write("\\")
                w |> write("\}")
            } elif (b == 10) {
                w |> write("\\n")
            } elif (b == 9) {
                w |> write("\\t")
            } elif (b == 13) {
                w |> write("\\r")
            } elif (b < 32 || b >= 127) {
                w |> write("\\x{fmt("%02x", b)}")
            } else {
                w |> write(to_char(b))
            }
        }
        w |> write("\"")
    }
    em.unsafe_used = true
    return value("reinterpret<uint8?>({text})", PREC_PRIMARY)
}

def private assignment_line(var em : Emitter; tu : CirTu; x : CirExpr; loc : CirLoc) : string {
    let lhs = emit_expr(em, tu, x.a, loc)
    let rhs = to_int(emit_expr(em, tu, x.b, loc))
    if (empty(x.op)) {
        return "{lhs.text} = {rhs.text}"
    }
    let spelled = BIN_SPELLING?[x.op] ?? ""
    let prec = BIN_PREC?[x.op] ?? 0
    if (kind_of(tu, x.a.t) == "ptr") {
        em.unsafe_used = true
        return "{lhs.text} = {lhs.text} {spelled} {wrap(rhs, prec + 1)}"
    }
    if (x.a.t != x.b.t) {
        let narrow = das_type(em, tu, x.a.t, loc)
        let wide = das_type(em, tu, x.b.t, loc)
        return "{lhs.text} = {narrow}({wide}({lhs.text}) {spelled} {wrap(rhs, prec + 1)})"
    }
    return "{lhs.text} {spelled}= {rhs.text}"
}

def private step_line(var em : Emitter; tu : CirTu; x : CirExpr; loc : CirLoc) : string {
    let operand = emit_expr(em, tu, x.a, loc)
    let up = x.op == "preinc" || x.op == "postinc"
    if (is_small_int(tu, x.a.t)) {
        let narrow = das_type(em, tu, x.a.t, loc)
        let wide = is_unsigned(tu, x.a.t) ? "uint" : "int"
        return "{operand.text} = {narrow}({wide}({operand.text}) {up ? "+" : "-"} 1)"
    }
    if (kind_of(tu, x.a.t) == "ptr") {
        em.unsafe_used = true
        return "{operand.text} = {operand.text} {up ? "+" : "-"} 1"
    }
    return "{operand.text}{up ? "++" : "--"}"
}

def private callee_name(var em : Emitter; fn : CirExpr?; loc : CirLoc) : string {
    var target = fn
    if (target != null && target.e == "cast" && target.cast_kind == "FunctionToPointerDecay") {
        target = target.a
    }
    if (target == null || target.e != "ref") {
        fail(em, "calls through pointers are not lowered yet", loc)
        return ""
    }
    if (key_exists(em.functions, target.name)) {
        return target.name == "main" ? "c_main" : das_name(em, target.name)
    }
    let mapped = LIBC_CALLS?[target.name] ?? ""
    if (empty(mapped)) {
        fail(em, "external function `{target.name}` has no c_runtime mapping", loc)
        return ""
    }
    em.requires |> insert(LIBC_MODULES?[target.name] ?? "")
    return mapped
}

def private emit_call(var em : Emitter; tu : CirTu; x : CirExpr; loc : CirLoc) : Em {
    let name = callee_name(em, x.fn, loc)
    var args : array<string>
    args |> reserve(length(x.args))
    for (arg in x.args) {
        args |> push(to_int(emit_expr(em, tu, arg, loc)).text)
    }
    return value("{name}({join(args, ", ")})", PREC_PRIMARY)
}

def private emit_cast(var em : Emitter; tu : CirTu; x : CirExpr; loc : CirLoc) : Em {
    let k = x.cast_kind
    if (k == "ArrayToPointerDecay" && x.a != null && x.a.e == "str_lit") {
        return string_literal(em, *x.a, loc)
    }
    let inner = emit_expr(em, tu, x.a, loc)
    if (k == "LValueToRValue" || k == "NoOp" || k == "ToVoid") {
        return inner
    }
    if (k == "IntegralToBoolean" || k == "FloatingToBoolean" || k == "PointerToBoolean") {
        return to_bool(inner, tu, x.a.t)
    }
    if (k == "BooleanToSignedIntegral") {
        return to_int(inner)
    }
    if (k == "NullToPointer") {
        return value("null", PREC_PRIMARY)
    }
    let target = das_type(em, tu, x.t, loc)
    if (k == "IntegralCast" || k == "IntegralToFloating" || k == "FloatingToIntegral" || k == "FloatingCast") {
        let source = to_int(inner)
        if (target == "bool") {
            return to_bool(source, tu, x.a.t)
        }
        return value("{target}({source.text})", PREC_PRIMARY)
    }
    if (k == "BitCast") {
        em.unsafe_used = true
        return value("reinterpret<{target}>({inner.text})", PREC_PRIMARY)
    }
    if (k == "PointerToIntegral") {
        return value("{target}(intptr({inner.text}))", PREC_PRIMARY)
    }
    if (k == "IntegralToPointer") {
        em.unsafe_used = true
        return value("reinterpret<{target}>(uint64({to_int(inner).text}))", PREC_PRIMARY)
    }
    if (k == "FunctionToPointerDecay") {
        return value("@@{das_name(em, x.a.name)}", PREC_PRIMARY)
    }
    if (k == "ArrayToPointerDecay") {
        em.unsafe_used = true
        return value("addr({inner.text}[0])", PREC_PRIMARY)
    }
    fail(em, "cast `{k}` is not lowered yet", loc)
    return inner
}

def private emit_binary(var em : Emitter; tu : CirTu; x : CirExpr; loc : CirLoc) : Em {
    let prec = BIN_PREC?[x.op] ?? 0
    let spelled = BIN_SPELLING?[x.op] ?? ""
    if (x.op == "land" || x.op == "lor") {
        let lhs = to_bool(emit_expr(em, tu, x.a, loc), tu, x.a.t)
        let mark = length(em.pre)
        let rhs = to_bool(emit_expr(em, tu, x.b, loc), tu, x.b.t)
        if (length(em.pre) == mark) {
            return truth("{wrap(lhs, prec)} {spelled} {wrap(rhs, prec + 1)}", prec)
        }
        let rhs_pre <- [for (idx in range(mark, length(em.pre))); em.pre[idx]]
        em.pre |> resize(mark)
        let tmp = temp_name(em)
        hoist(em, ["var {tmp} = {lhs.text}", "if ({x.op == "land" ? tmp : "!" + tmp}) \{"])
        hoist(em, [for (stmt in rhs_pre); "    {stmt}"])
        hoist(em, ["    {tmp} = {rhs.text}", "\}"])
        return truth(tmp, PREC_PRIMARY)
    }
    let lhs = to_int(emit_expr(em, tu, x.a, loc))
    var rhs = to_int(emit_expr(em, tu, x.b, loc))
    let pointer_lhs = kind_of(tu, x.a.t) == "ptr"
    let pointer_rhs = kind_of(tu, x.b.t) == "ptr"
    if (x.op == "lt" || x.op == "gt" || x.op == "le" || x.op == "ge") {
        if (pointer_lhs && pointer_rhs) {
            return truth("intptr({lhs.text}) {spelled} intptr({rhs.text})", prec)
        }
        return truth("{wrap(lhs, prec + 1)} {spelled} {wrap(rhs, prec + 1)}", prec)
    }
    if (x.op == "eq" || x.op == "ne") {
        return truth("{wrap(lhs, prec + 1)} {spelled} {wrap(rhs, prec + 1)}", prec)
    }
    if ((x.op == "shl" || x.op == "shr") && is_unsigned(tu, x.a.t) && !is_unsigned(tu, x.b.t)) {
        rhs = value(x.b.e == "int_lit" ? x.b.v + "u" : "uint({rhs.text})", PREC_PRIMARY)
    }
    if (pointer_lhs || pointer_rhs) {
        em.unsafe_used = true
    }
    return value("{wrap(lhs, prec)} {spelled} {wrap(rhs, prec + 1)}", prec)
}

def private emit_cond(var em : Emitter; tu : CirTu; x : CirExpr; loc : CirLoc) : Em {
    let c = to_bool(emit_expr(em, tu, x.c, loc), tu, x.c.t)
    let mark = length(em.pre)
    let a = emit_expr(em, tu, x.a, loc)
    let a_end = length(em.pre)
    let b = emit_expr(em, tu, x.b, loc)
    if (length(em.pre) == mark) {
        if (a.is_bool && b.is_bool) {
            return truth("{wrap(c, PREC_COND + 1)} ? {wrap(a, PREC_COND + 1)} : {wrap(b, PREC_COND + 1)}", PREC_COND)
        }
        return value("{wrap(c, PREC_COND + 1)} ? {wrap(to_int(a), PREC_COND + 1)} : {wrap(to_int(b), PREC_COND + 1)}", PREC_COND)
    }
    let a_pre <- [for (idx in range(mark, a_end)); em.pre[idx]]
    let b_pre <- [for (idx in range(a_end, length(em.pre))); em.pre[idx]]
    em.pre |> resize(mark)
    let tmp = temp_name(em)
    let spelled = das_type(em, tu, x.t, loc)
    hoist(em, ["var {tmp} : {spelled}", "if ({c.text}) \{"])
    hoist(em, [for (stmt in a_pre); "    {stmt}"])
    hoist(em, ["    {tmp} = {to_int(a).text}", "\} else \{"])
    hoist(em, [for (stmt in b_pre); "    {stmt}"])
    hoist(em, ["    {tmp} = {to_int(b).text}", "\}"])
    return value(tmp, PREC_PRIMARY)
}

def private emit_unary(var em : Emitter; tu : CirTu; x : CirExpr; loc : CirLoc) : Em {
    if (x.op == "not") {
        let a = to_bool(emit_expr(em, tu, x.a, loc), tu, x.a.t)
        return truth("!{wrap(a, PREC_UNARY)}", PREC_UNARY)
    }
    if (x.op == "preinc" || x.op == "predec") {
        em.pre |> push(step_line(em, tu, x, loc))
        return emit_expr(em, tu, x.a, loc)
    }
    if (x.op == "postinc" || x.op == "postdec") {
        let tmp = temp_name(em)
        let before = emit_expr(em, tu, x.a, loc)
        hoist(em, ["let {tmp} = {before.text}", step_line(em, tu, x, loc)])
        return value(tmp, PREC_PRIMARY)
    }
    let a = to_int(emit_expr(em, tu, x.a, loc))
    if (x.op == "neg") {
        return value("-{wrap(a, PREC_UNARY)}", PREC_UNARY)
    }
    if (x.op == "plus") {
        return a
    }
    if (x.op == "bnot") {
        return value("~{wrap(a, PREC_UNARY)}", PREC_UNARY)
    }
    if (x.op == "addr") {
        em.unsafe_used = true
        return value("addr({a.text})", PREC_PRIMARY)
    }
    if (x.op == "deref") {
        em.unsafe_used = true
        return value("deref({a.text})", PREC_PRIMARY)
    }
    fail(em, "unary `{x.op}` is not lowered yet", loc)
    return a
}

def emit_expr(var em : Emitter; tu : CirTu; x : CirExpr?; loc : CirLoc) : Em {
    if (x == null) {
        fail(em, "missing expression", loc)
        return value("", PREC_PRIMARY)
    }
    if (x.e == "int_lit" || x.e == "float_lit") {
        return literal(em, tu, *x, loc)
    }
    if (x.e == "str_lit") {
        fail(em, "a string literal outside a pointer context is not lowered yet", loc)
        return value("", PREC_PRIMARY)
    }
    if (x.e == "ref") {
        return value(das_name(em, x.name), PREC_PRIMARY)
    }
    if (x.e == "cast") {
        return emit_cast(em, tu, *x, loc)
    }
    if (x.e == "un") {
        return emit_unary(em, tu, *x, loc)
    }
    if (x.e == "bin") {
        return emit_binary(em, tu, *x, loc)
    }
    if (x.e == "assign") {
        em.pre |> push(assignment_line(em, tu, *x, loc))
        return emit_expr(em, tu, x.a, loc)
    }
    if (x.e == "cond") {
        return emit_cond(em, tu, *x, loc)
    }
    if (x.e == "comma") {
        emit_effect(em, tu, x.a, loc)
        return emit_expr(em, tu, x.b, loc)
    }
    if (x.e == "call") {
        return emit_call(em, tu, *x, loc)
    }
    if (x.e == "sizeof_v") {
        return value("{das_type(em, tu, x.t, loc)}(typeinfo sizeof(type<{das_type(em, tu, x.of_t, loc)}>))", PREC_PRIMARY)
    }
    if (x.e == "index") {
        let base = emit_expr(em, tu, x.base, loc)
        let i = to_int(emit_expr(em, tu, x.i, loc))
        if (kind_of(tu, x.base.t) == "ptr") {
            em.unsafe_used = true
            return value("deref({wrap(base, PREC_ADD)} + {wrap(i, PREC_ADD + 1)})", PREC_PRIMARY)
        }
        return value("{wrap(base, PREC_PRIMARY)}[{i.text}]", PREC_PRIMARY)
    }
    fail(em, "expression `{x.e}` is not lowered yet", loc)
    return value("", PREC_PRIMARY)
}

// an expression evaluated for its effect alone: the statement forms of assignment, the
// steps and calls, everything else through its pre-statements
def private emit_effect(var em : Emitter; tu : CirTu; x : CirExpr?; loc : CirLoc) {
    if (x == null) {
        return
    }
    if (x.e == "assign") {
        em.pre |> push(assignment_line(em, tu, *x, loc))
    } elif (x.e == "un" && (x.op == "preinc" || x.op == "predec" || x.op == "postinc" || x.op == "postdec")) {
        em.pre |> push(step_line(em, tu, *x, loc))
    } elif (x.e == "call") {
        em.pre |> push(emit_call(em, tu, *x, loc).text)
    } elif (x.e == "comma") {
        emit_effect(em, tu, x.a, loc)
        emit_effect(em, tu, x.b, loc)
    } elif (x.e == "cast" && (x.cast_kind == "ToVoid" || x.cast_kind == "LValueToRValue" || x.cast_kind == "NoOp")) {
        emit_effect(em, tu, x.a, loc)
    } else {
        let e = emit_expr(em, tu, x, loc)
        if (x.e != "ref" && x.e != "int_lit" && x.e != "float_lit") {
            em.pre |> push("let _ = {e.text}")
        }
    }
}

def private emit_body(var em : Emitter; tu : CirTu; st : CirStmt?) {
    if (st == null) {
        return
    }
    if (st.s == "compound") {
        for (child in st.body) {
            emit_stmt(em, tu, child)
        }
    } else {
        emit_stmt(em, tu, st)
    }
}

def private open_block(var em : Emitter; head : string) {
    line(em, empty(head) ? "\{" : head + " \{")
    em.depth++
}

def private close_block(var em : Emitter) {
    em.depth--
    line(em, "\}")
}

def private emit_if(var em : Emitter; tu : CirTu; st : CirStmt; head : string) {
    let c = to_bool(emit_expr(em, tu, st.cond, st.loc), tu, st.cond.t)
    flush_pre(em)
    open_block(em, "{head} ({c.text})")
    emit_body(em, tu, st.then_s)
    if (st.else_s != null) {
        if (st.else_s.s == "if") {
            let mark = length(em.pre)
            let probe = to_bool(emit_expr(em, tu, st.else_s.cond, st.else_s.loc), tu, st.else_s.cond.t)
            let pure = length(em.pre) == mark
            em.pre |> resize(mark)
            if (pure) {
                em.depth--
                emit_if(em, tu, *st.else_s, "\} elif")
                return
            }
        }
        em.depth--
        open_block(em, "\} else")
        emit_body(em, tu, st.else_s)
    }
    close_block(em)
}

def private emit_while(var em : Emitter; tu : CirTu; st : CirStmt) {
    let mark = length(em.pre)
    let c = to_bool(emit_expr(em, tu, st.cond, st.loc), tu, st.cond.t)
    if (length(em.pre) == mark) {
        open_block(em, "while ({c.text})")
        emit_body(em, tu, st.body_s)
        close_block(em)
        return
    }
    let cond_pre <- [for (idx in range(mark, length(em.pre))); em.pre[idx]]
    em.pre |> resize(mark)
    open_block(em, "while (true)")
    for (stmt in cond_pre) {
        line(em, stmt)
    }
    open_block(em, "if (!({c.text}))")
    line(em, "break")
    close_block(em)
    emit_body(em, tu, st.body_s)
    close_block(em)
}

def private numbered(base : string; count : int) : string {
    return count == 1 ? base : "{base}{count}"
}

def private emit_do(var em : Emitter; tu : CirTu; st : CirStmt) {
    let mark = length(em.pre)
    let c = to_bool(emit_expr(em, tu, st.cond, st.loc), tu, st.cond.t)
    if (length(em.pre) != mark) {
        em.pre |> resize(mark)
        fail(em, "do-while with a side-effecting condition is not lowered yet", st.loc)
        return
    }
    em.first_counter++
    let flag = numbered("_first", em.first_counter)
    line(em, "var {flag} = true")
    open_block(em, "while ({flag} || {wrap(c, PREC_LOR + 1)})")
    line(em, "{flag} = false")
    emit_body(em, tu, st.body_s)
    close_block(em)
}

// true when the body can leave the loop in a way C's increment must not follow: a `break` at
// this loop's level, a `return` or a `goto` anywhere inside
def private leaves_loop(st : CirStmt?; nested : bool) : bool {
    if (st == null) {
        return false
    }
    if (st.s == "return" || st.s == "goto") {
        return true
    }
    if (st.s == "break") {
        return !nested
    }
    let inner = nested || st.s == "while" || st.s == "do" || st.s == "for"
    for (child in st.body) {
        if (leaves_loop(child, inner)) {
            return true
        }
    }
    return leaves_loop(st.then_s, inner) || leaves_loop(st.else_s, inner) || leaves_loop(st.body_s, inner)
}

def private emit_for_flag(var em : Emitter; tu : CirTu; st : CirStmt) {
    em.for_counter++
    let flag = numbered("_f", em.for_counter)
    line(em, "var {flag} = false")
    open_block(em, "while (true)")
    open_block(em, "if ({flag})")
    emit_effect(em, tu, st.inc, st.loc)
    flush_pre(em)
    close_block(em)
    line(em, "{flag} = true")
    if (st.cond != null) {
        let c = to_bool(emit_expr(em, tu, st.cond, st.loc), tu, st.cond.t)
        flush_pre(em)
        open_block(em, "if (!({c.text}))")
        line(em, "break")
        close_block(em)
    }
    emit_body(em, tu, st.body_s)
    close_block(em)
}

// the loop head: `while (cond)`, or `while (true)` plus the test when the condition
// carries hoisted statements or is absent
def private open_for_head(var em : Emitter; tu : CirTu; st : CirStmt) {
    if (st.cond == null) {
        open_block(em, "while (true)")
        return
    }
    let mark = length(em.pre)
    let c = to_bool(emit_expr(em, tu, st.cond, st.loc), tu, st.cond.t)
    if (length(em.pre) == mark) {
        open_block(em, "while ({c.text})")
        return
    }
    let cond_pre <- [for (idx in range(mark, length(em.pre))); em.pre[idx]]
    em.pre |> resize(mark)
    open_block(em, "while (true)")
    for (stmt in cond_pre) {
        line(em, stmt)
    }
    open_block(em, "if (!({c.text}))")
    line(em, "break")
    close_block(em)
}

def private emit_for(var em : Emitter; tu : CirTu; st : CirStmt) {
    open_block(em, "")
    if (st.init_s != null) {
        emit_body(em, tu, st.init_s)
    }
    if (st.inc != null && leaves_loop(st.body_s, false)) {
        emit_for_flag(em, tu, st)
    } else {
        open_for_head(em, tu, st)
        if (st.inc == null) {
            emit_body(em, tu, st.body_s)
        } else {
            open_block(em, "")
            emit_body(em, tu, st.body_s)
            em.depth--
            open_block(em, "\} finally")
            emit_effect(em, tu, st.inc, st.loc)
            flush_pre(em)
            close_block(em)
        }
        close_block(em)
    }
    close_block(em)
}

def emit_stmt(var em : Emitter; tu : CirTu; st : CirStmt?) {
    if (st == null) {
        return
    }
    if (st.s == "compound") {
        open_block(em, "")
        for (child in st.body) {
            emit_stmt(em, tu, child)
        }
        close_block(em)
    } elif (st.s == "decl") {
        let spelled = das_type(em, tu, st.t, st.loc)
        if (st.init == null) {
            line(em, "var {das_name(em, st.name)} : {spelled}")
        } else {
            let init = to_int(emit_expr(em, tu, st.init, st.loc))
            flush_pre(em)
            line(em, "var {das_name(em, st.name)} : {spelled} = {init.text}")
        }
    } elif (st.s == "expr") {
        emit_effect(em, tu, st.e, st.loc)
        flush_pre(em)
    } elif (st.s == "return") {
        if (st.e == null) {
            line(em, "return")
        } else {
            let e = to_int(emit_expr(em, tu, st.e, st.loc))
            flush_pre(em)
            line(em, "return {e.text}")
        }
    } elif (st.s == "if") {
        emit_if(em, tu, *st, "if")
    } elif (st.s == "while") {
        emit_while(em, tu, *st)
    } elif (st.s == "do") {
        emit_do(em, tu, *st)
    } elif (st.s == "for") {
        emit_for(em, tu, *st)
    } elif (st.s == "break") {
        line(em, "break")
    } elif (st.s == "continue") {
        line(em, "continue")
    } elif (st.s == "null") {
        return
    } else {
        fail(em, "statement `{st.s}` is not lowered yet", st.loc)
    }
}

// the names a body assigns, steps or takes the address of: a parameter among them needs the
// callee-side copy C's by-value semantics give it
def private collect_written(x : CirExpr?; var names : table<string>) {
    if (x == null) {
        return
    }
    if (x.e == "assign" || (x.e == "un" && (x.op == "preinc" || x.op == "predec" || x.op == "postinc" || x.op == "postdec" || x.op == "addr"))) {
        var target = x.a
        while (target != null && target.e == "cast") {
            target = target.a
        }
        if (target != null && target.e == "ref") {
            names |> insert(target.name)
        }
    }
    collect_written(x.a, names)
    collect_written(x.b, names)
    collect_written(x.c, names)
    collect_written(x.fn, names)
    for (arg in x.args) {
        collect_written(arg, names)
    }
    collect_written(x.base, names)
    collect_written(x.i, names)
    collect_written(x.init, names)
}

def private collect_written_stmt(st : CirStmt?; var names : table<string>) {
    if (st == null) {
        return
    }
    for (child in st.body) {
        collect_written_stmt(child, names)
    }
    collect_written(st.init, names)
    collect_written(st.e, names)
    collect_written(st.cond, names)
    collect_written(st.inc, names)
    collect_written_stmt(st.then_s, names)
    collect_written_stmt(st.else_s, names)
    collect_written_stmt(st.body_s, names)
    collect_written_stmt(st.init_s, names)
}

// C lets a non-void function fall off its end (the value is then unspecified, and main's is
// 0); das wants every path to return, so the body gets a trailing zero
def private ends_in_return(st : CirStmt?) : bool {
    if (st == null) {
        return false
    }
    if (st.s == "return") {
        return true
    }
    if (st.s == "compound") {
        return !empty(st.body) && ends_in_return(st.body[length(st.body) - 1])
    }
    if (st.s == "if") {
        return ends_in_return(st.then_s) && ends_in_return(st.else_s)
    }
    return false
}

def private zero_of(spelled : string) : string {
    if (spelled == "bool") {
        return "false"
    }
    if (spelled == "float") {
        return "0.0f"
    }
    if (spelled == "double") {
        return "0.0lf"
    }
    if (spelled |> ends_with("?")) {
        return "null"
    }
    return spelled == "int" ? "0" : "{spelled}(0)"
}

def private das_func_name(var em : Emitter; d : CirDecl) : string {
    if (d.c_name == "main" && !d.is_static) {
        em.has_c_main = true
        return "c_main"
    }
    return das_name(em, d.name)
}

def private emit_function(var em : Emitter; tu : CirTu; d : CirDecl) {
    if (d.body == null) {
        return
    }
    if (tu.types[d.t].variadic) {
        fail(em, "variadic function definitions are not lowered yet", d.loc)
        return
    }
    if (d.c_name == "main" && !empty(d.params)) {
        fail(em, "main with arguments is not lowered yet", d.loc)
        return
    }
    em.written |> clear()
    em.renames |> clear()
    em.temp_counter = 0
    em.first_counter = 0
    em.for_counter = 0
    em.unsafe_used = false
    collect_written_stmt(d.body, em.written)
    var params : array<string>
    var copies : array<string>
    for (p in d.params) {
        let spelled = das_type(em, tu, p.t, d.loc)
        let name = das_name(em, p.name)
        if (key_exists(em.written, p.name)) {
            params |> push("{name}_in : {spelled}")
            copies |> push("var {name} = {name}_in")
        } else {
            params |> push("{name} : {spelled}")
        }
    }
    let ret = das_type(em, tu, tu.types[d.t].ret, d.loc)
    let header = "def {d.is_static ? "private " : ""}{das_func_name(em, d)}" + (empty(params) ? "" : "({join(params, "; ")})") + (ret == "void" ? "" : " : {ret}")
    let header_at = length(em.out)
    open_block(em, header)
    for (copy in copies) {
        line(em, copy)
    }
    emit_body(em, tu, d.body)
    if (ret != "void" && !ends_in_return(d.body)) {
        line(em, "return {zero_of(ret)}")
    }
    close_block(em)
    line(em, "")
    if (em.unsafe_used) {
        em.out[header_at] = "[c_function]\n" + em.out[header_at]
        em.requires |> insert("c_runtime/c_function")
    }
}

def private emit_global(var em : Emitter; tu : CirTu; d : CirDecl) {
    if (d.is_extern) {
        return
    }
    let spelled = das_type(em, tu, d.t, d.loc)
    let head = "var {d.is_static ? "private " : ""}{das_name(em, d.name)} : {spelled}"
    if (d.init == null) {
        line(em, head)
        return
    }
    em.unsafe_used = false
    let init = to_int(emit_expr(em, tu, d.init, d.loc))
    if (!empty(em.pre)) {
        em.pre |> clear()
        fail(em, "a global initializer with side effects is not lowered yet", d.loc)
        return
    }
    let init_text = em.unsafe_used ? "unsafe({init.text})" : init.text
    line(em, "{head} = {init_text}")
}

//! The whole module: banner, options, requires, every declaration, and the `main` wrapper
//! when the C program has one. Empty with `error` set when a node is outside the subset.
def emit_tu(tu : CirTu) : Emitter {
    var em : Emitter
    for (d in tu.decls) {
        if (d.k == "func" && d.body != null) {
            em.functions |> insert(d.name)
        }
    }
    var globals_done = false
    for (d in tu.decls) {
        if (d.k == "global") {
            emit_global(em, tu, *d)
            globals_done = true
        }
        break if (!empty(em.error))
    }
    if (globals_done) {
        line(em, "")
    }
    for (d in tu.decls) {
        if (d.k == "func") {
            emit_function(em, tu, *d)
        }
        break if (!empty(em.error))
    }
    if (em.has_c_main) {
        line(em, "[export]")
        open_block(em, "def main : int")
        line(em, "return c_main()")
        close_block(em)
    }
    var required <- [for (name in keys(em.requires)); name]
    required |> sort()
    let header = join([for (name in required); "require {name}\n"], "")
    em.text = GENERATED_BANNER + "\noptions gen2\noptions indenting = 4\n" + header + "\n" + join(em.out, "")
    return <- em
}
