options gen2

require daslib/fio
require daslib/strings_boost
require dastest/review_gate
require ../suites/suite_files.das

// The mechanical half of lua/REVIEW.md (contract: REVIEW_COMMON.md at the repo root).
// Run from the repo root: daslang lua/REVIEW.das - exit 0 clean, 1 with findings.

// `SOURCES` in sources.das names the folder of the release the `lua:` line of VERSIONS.md pins
def private check_sources_release {
    var release = ""
    for (line in read_lines("VERSIONS.md")) {
        if (line |> starts_with("lua: ")) {
            release = split(slice(line, 5), " ")[0]
        }
    }
    if (empty(release)) {
        gate_finding("VERSIONS.md", "no `lua:` line names the release")
        return
    }
    let sources = fexist("lua/sources.das") ? fread("lua/sources.das") : ""
    if (find_line(sources, "let SOURCES = \"lua/fetch/lua-{release}/src\"") == 0) {
        gate_finding("lua/sources.das", "`SOURCES` is not lua/fetch/lua-{release}/src, the release the `lua:` line of VERSIONS.md pins")
    }
}

[export]
def main : int {
    check_sources_release()
    gate_untracked(["lua/fetch", "lua/work"], "lua/fetch/ and lua/work/ are regenerated by fetch.sh and run.das, never committed")
    return gate_verdict("lua")
}
