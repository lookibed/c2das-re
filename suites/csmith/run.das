options gen2
// the pipeline parses clang's JSON dump below its own frames: a deep expression tree overflows
// the default 16 KB context stack, and dastest gives its tests this much
options stack = 1048576

require strings
require daslib/strings_boost
require daslib/fio
require daslib/clargs
require daslib/random
require math
require ../suite_runner.das
require ../../converter/pipeline.das
require ../../converter/cir.das
require ../../converter/tiers.das
require verdict
require generate

//! The csmith differential (`scripts/run_suite.sh csmith`): each seed's program is generated by
//! the pinned csmith, built natively by the pinned gcc at `-O0 -fwrapv` under the `linux`
//! dialect's char, then converted and run under `--tier` (the interpreter unless given); a seed
//! passes when both runs exit 0 with the same merged output (csmith prints `checksum = ...`).
//! `expected_pass.txt` holds the seeds known clean, each rerun on every run, and `--seeds N` adds
//! N fresh ones. One worker process per seed, `--jobs` at a time; a worker writes its verdict
//! beside the seed's program.

let WORK_DIR = "suites/csmith/work"
let EXPECTED_PASS = "suites/csmith/expected_pass.txt"
let SKIP_LEDGER = "suites/csmith/skip.txt"

// the reference: gcc at -O0 under the dialect's wrapping and unsigned `char`
let NATIVE_FLAGS <- ["-O0", "-fwrapv", "-w", "-funsigned-char"]

// seconds the native program may run; the interpreter runs csmith's code a hundred times slower
let NATIVE_TIMEOUT = 2.0

// seconds the converted program may run
let RUN_TIMEOUT = 300.0

// seconds a worker may live before the driver kills it
let WORKER_TIMEOUT = 900.0

// seconds a worker gives its own timed children: the driver's limit less the margin for the
// conversion's own clang child (120 s) and a verdict's write, so the driver's kill never lands
// while a timed child is alive
let WORKER_BUDGET = 750.0

[CommandLineArgs]
struct CsmithArgs {
    @clarg_doc = "fresh random seeds this run adds (default 4, or 0 with --seed or --from)"
    seeds : int = -1
    @clarg_doc = "judge this seed instead of the ratchet's, skip.txt or not"
    seed : string = ""
    @clarg_doc = "judge the seeds this file lists, one per line, instead of the ratchet's, skip.txt or not"
    from : string = ""
    @clarg_doc = "record in expected_pass.txt every seed that passed, drop every listed one that failed"
    update : bool
    @clarg_doc = "also log the seeds that pass; every other seed is always logged"
    verbose : bool
    @clarg_doc = "run only the seeds whose number contains this text, fresh ones included"
    filter : string = ""
    @clarg_doc = "seeds converted at once, one worker process each"
    jobs : int = 4
    @clarg_doc = "tier the converted programs run under: interp (default), jit or exe; the ratchet is the interpreter's, so --update needs interp"
    tier : string = "interp"
    @clarg_doc = "judge only the seeds skip.txt lists, writing work/skip_audit.tsv; the ratchet is not judged, and only --update writes it, adding the audited seeds that pass"
    audit_skips : bool
    @clarg_doc = "worker: generate, build, convert and judge this seed, writing work/<seed>/<seed>.verdict"
    one : string = ""
    @clarg_doc = "judge this generated program as a seed, writing <stem>.verdict beside it"
    check : string = ""
    @clarg_short = "?"
    @clarg_name = "show-help"
    @clarg_doc = "show this help and exit"
    show_help : bool
}

// a timed stage's limit: its own, or what is left of the worker's budget when that is less
def private limit_of(own : float; t0 : int64) : float => min(own, WORKER_BUDGET - seconds_since(t0))

def private timed_out(stage : string; seconds : float) : Verdict =>
    Verdict(status = "timeout", signature = "timeout {stage}", reason = "{stage} took longer than {int(seconds)} s")

// `text` with every span between two `quote`s spelled `_`
def private blank_quoted(text, quote : string) : string {
    var parts <- split(text, quote)
    for (idx in range(length(parts))) {
        if (idx % 2 == 1) {
            parts[idx] = "_"
        }
    }
    return join(parts, quote)
}

// a converter error as a reduction compares it: its first line with no file, line or column,
// every name in backticks or quotes blanked (the reducer renames what it keeps, and a module's
// names carry the file's stem) and no count of further errors
def private error_signature(error : string) : string {
    var text = error
    let located = find(text, ".c:")
    if (located >= 0) {
        let after = find(text, ": ", located + 3)
        text = after < 0 ? text : slice(text, after + 2)
    }
    text = blank_quoted(blank_quoted(text, "`"), "'")
    let more = find(text, " (+")
    return more < 0 ? text : slice(text, 0, more)
}

// one generated program judged: the native reference, the conversion, its run under `tier`,
// compared; `t0` is when the worker started
def private judge(c_path, tier : string; t0 : int64) : Verdict {
    let native_limit = limit_of(NATIVE_TIMEOUT, t0)
    let native = native_run("gcc", NATIVE_FLAGS, c_path, path_join(dir_name(c_path), "{file_stem(c_path)}_native"), native_limit)
    if (!native.built) {
        return Verdict(status = "native", signature = "native", reason = "gcc refused it: {first_line(native.output)}")
    }
    if (native.rc == popen_timed_out) {
        return timed_out("the native run", native_limit)
    }
    if (native.rc != 0) {
        return Verdict(status = "native", signature = "native", reason = "the native run exited {native.rc}")
    }
    let work = path_join(dir_name(c_path), "das")
    let run_limit = limit_of(RUN_TIMEOUT, t0)
    let run = convert_and_run(c_path, work, "linux", tier, run_limit, ["-no-module-cache"])
    if (!run.converted) {
        return Verdict(status = "convert", signature = error_signature(run.error), reason = run.error)
    }
    if (run_limit <= 0.0 || run.rc == popen_timed_out) {
        return timed_out(run_limit <= 0.0 ? "the conversion" : "the converted run", run_limit)
    }
    let outcome = compare_output(file_stem(c_path), run.rc, run.output, native.output)
    return Verdict(status = outcome.status, signature = outcome.status == "exit" ? "exit {run.rc}" : outcome.status, reason = outcome.reason)
}

// the seed's program generated and spliced into work/<seed>/<seed>.c, then judged under `tier`
def private judge_seed(seed, tier : string) : Verdict {
    let t0 = ref_time_ticks()
    let csmith_limit = limit_of(CSMITH_TIMEOUT, t0)
    let prog = csmith_program(seed, "{WORK_DIR}/{seed}", csmith_limit)
    if (prog.timed_out) {
        return timed_out("csmith", csmith_limit)
    }
    if (!empty(prog.error)) {
        return Verdict(status = "native", signature = "native", reason = prog.error)
    }
    return judge(prog.c_path, tier, t0)
}

// the seeds of this run: the ones named, else the ratchet's and the ledger's, then `fresh` new
// ones no list holds; `filter` narrows every source, fresh seeds included
def private run_seeds(args : CsmithArgs; ratchet : Ratchet) : array<string> {
    var seeds : array<string>
    let named = !empty(args.seed) || !empty(args.from)
    if (named) {
        if (!empty(args.seed)) {
            seeds |> push(args.seed)
        }
        if (!empty(args.from)) {
            seeds |> push_from(read_lines(args.from))
        }
    } else {
        seeds |> push_from(ratchet.expected)
        for (s in keys(ratchet.skips)) {
            seeds |> push(s)
        }
    }
    var chosen : table<string>
    var out : array<string>
    for (s in seeds) {
        if (!key_exists(chosen, s) && (empty(args.filter) || find(s, args.filter) >= 0)) {
            chosen |> insert(s)
            out |> push(s)
        }
    }
    let fresh = args.seeds >= 0 ? args.seeds : (named ? 0 : 4)
    var rng = random_seed(int(ref_time_ticks()))
    var added = 0
    // a filter few seeds match gives up after this many draws
    var draws = 1000000
    while (added < fresh && draws > 0) {
        draws--
        let s = "{random_big_int(rng) + 1}"
        if (!key_exists(chosen, s) && !key_exists(ratchet.skips, s) && (empty(args.filter) || find(s, args.filter) >= 0)) {
            chosen |> insert(s)
            out |> push(s)
            added++
        }
    }
    return <- out
}

// every seed through a worker running its program under `tier`, `jobs` at a time, into `outcomes`
def private drive(seeds : array<string>; jobs : int; tier : string; var outcomes : array<Outcome>) {
    run_workers(length(seeds), jobs, WORKER_TIMEOUT, $(index) => spawn_one("suites/csmith/run.das", seeds[index], verdict_path("{WORK_DIR}/{seeds[index]}/{seeds[index]}.c"), ["--tier", tier])) $(index, killed, rc, _output) {
        let seed = seeds[index]
        outcomes |> push(worker_outcome(seed, killed, rc, WORKER_TIMEOUT, killed ? Verdict() : read_verdict("{WORK_DIR}/{seed}/{seed}.c")))
    }
}

// every seed judged, a listed seed that timed out once more, alone, at the end
def private judge_seeds(seeds : array<string>; jobs : int; tier : string; ratchet : Ratchet) : array<Outcome> {
    var first : array<Outcome>
    drive(seeds, jobs, tier, first)
    let retried <- [for (o in first); o.id; where o.status == "timeout" && key_exists(ratchet.expected_set, o.id)]
    var again : array<Outcome>
    drive(retried, 1, tier, again)
    var outcomes <- [for (o in first); o; where !(retried |> has_value(o.id))]
    outcomes |> push_from(again)
    return <- outcomes
}

// the outcomes into the tally, every seed that does not pass logged; `failed` gets the seeds
// that ran and did not pass, a timeout aside; true when a converted program diverged
def private tally_outcomes(outcomes : array<Outcome>; ratchet : Ratchet; verbose : bool; var tally : Tally; var failed : table<string>) : bool {
    var diverged = false
    for (outcome in outcomes) {
        if (outcome.status == "timeout") {
            // never a regression and never recorded: the ratchet keeps a listed seed as it was
            count_status(tally, "timeout")
            to_log(LOG_INFO, "{outcome.id}: timeout: {outcome.reason}\n")
            continue
        }
        diverged = diverged || outcome.status == "output" || outcome.status == "exit"
        if (outcome.status == "pass" && key_exists(ratchet.skips, outcome.id)) {
            count_status(tally, "pass")
            to_log(LOG_INFO, "ledgered seed now passes, move it out of skip.txt: {outcome.id}\n")
            continue
        }
        if (outcome.status != "pass") {
            failed |> insert(outcome.id)
        } elif (verbose) {
            to_log(LOG_INFO, "{outcome.id}: pass\n")
        }
        record(tally, ratchet, outcome, true)
    }
    return diverged
}

// the ratchet after the run, sorted: its seeds this run did not fail, and the ones that passed
def private ratchet_after(ratchet : Ratchet; failed : table<string>; tally : Tally) : array<string> {
    var kept : table<string>
    for (s in ratchet.expected) {
        if (!key_exists(failed, s)) {
            kept |> insert(s)
        }
    }
    for (s in tally.passed) {
        kept |> insert(s)
    }
    var ratchet_ids <- [for (s in keys(kept)); s]
    ratchet_ids |> sort()
    return <- ratchet_ids
}

// the skip audit: every seed skip.txt lists whose number holds `filter` judged through a worker,
// with no rerun of a timeout, into work/skip_audit.tsv; under `update` the seeds that pass join
// the ratchet
def private audit_seeds(filter : string; jobs : int; tier : string; update : bool) {
    let lines <- audited_lines(read_skip_lines(SKIP_LEDGER), filter)
    let feature_of <- {for (line in lines); line.id => line.feature}
    let seeds <- [for (line in lines); line.id]
    var outcomes : array<Outcome>
    drive(seeds, jobs, tier, outcomes)
    let rows <- [for (o in outcomes); audit_row(feature_of?[o.id] ?? "", o)]
    finish_audit("csmith", WORK_DIR, rows)
    if (update) {
        join_audit_passes("csmith", EXPECTED_PASS, rows)
    }
}

// the gcc version VERSIONS.md pins against `gcc -dumpfullversion`: "" when they agree
def private gcc_pin_mismatch : string {
    var pin = ""
    for (line in read_lines("VERSIONS.md")) {
        if (line |> starts_with("gcc: ")) {
            pin = split(slice(line, 5), " ")[0]
        }
    }
    var version : string
    run_and_capture(["gcc", "-dumpfullversion"], version, 30.0)
    return pin == strip(version) ? "" : "gcc is `{strip(version)}`, VERSIONS.md pins `{pin}`"
}

[export]
def main : int {
    var args = CsmithArgs()
    let parsed = cli_prologue(args, "run_suite csmith")
    if (parsed >= 0) {
        return parsed
    }
    let refusal = tier_refusal(args.tier, args.update)
    if (!empty(refusal)) {
        to_log(LOG_ERROR, "{refusal}\n")
        return 2
    }
    if (!empty(args.one)) {
        write_verdict("{WORK_DIR}/{args.one}/{args.one}.c", judge_seed(args.one, args.tier))
        return 0
    }
    let mismatch = gcc_pin_mismatch()
    if (!empty(mismatch)) {
        to_log(LOG_ERROR, "{mismatch}\n")
        return 2
    }
    if (!empty(args.check)) {
        write_verdict(args.check, judge(args.check, args.tier, ref_time_ticks()))
        return 0
    }
    if (!fexist("{CSMITH_DIR}/build/src/csmith")) {
        to_log(LOG_ERROR, "{CSMITH_DIR}/build/src/csmith is missing: run suites/csmith/fetch.sh\n")
        return 2
    }
    if (args.audit_skips) {
        audit_seeds(args.filter, args.jobs, args.tier, args.update)
        return 0
    }
    let ratchet <- read_ratchet(EXPECTED_PASS, SKIP_LEDGER)
    let seeds <- run_seeds(args, ratchet)
    let named = !empty(args.seed) || !empty(args.from)
    // a named seed is judged whatever the ledger says; the ratchet's run skips the ledgered ones
    let judged <- [for (s in seeds); s; where named || !key_exists(ratchet.skips, s)]
    let outcomes <- judge_seeds(judged, args.jobs, args.tier, ratchet)
    var tally : Tally
    for (_s in range(length(seeds) - length(judged))) {
        count_status(tally, "skip")
    }
    var failed : table<string>
    let diverged = tally_outcomes(outcomes, ratchet, args.verbose, tally, failed)
    let ratchet_ids <- ratchet_after(ratchet, failed, tally)
    let rc = finish_run("csmith", EXPECTED_PASS, tally, args.update, !empty(args.filter), ratchet_ids)
    if (diverged) {
        to_log(LOG_ERROR, "a converted program diverged from its native build: a converter bug by construction\n")
        return 1
    }
    return rc
}
