options gen2

require daslib/fio

[export]
def initialize(project_path : string) {
    for (name in ["c_function", "enum_from_int", "c_exit", "cstr_array", "cstr", "int_of", "c_do_while", "c_switch", "variadic", "printf", "setjmp", "c_bitfields", "c_union", "c_storage", "c_sort", "scanf", "c_bounds", "c_args", "c_signal", "c_volatile", "c_volatile_jit", "c_builtins", "c_jit_build", "c_macro"]) {
        register_native_path("c_runtime", name, "{project_path}/c_runtime/{name}.das")
    }
    register_module_group("llvm_code_generator", "c_runtime/c_volatile_jit")
}
