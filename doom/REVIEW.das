options gen2

require dastest/review_gate
require ../suites/suite_files.das

// The mechanical half of doom/REVIEW.md (contract: REVIEW_COMMON.md at the repo root).
// Run from the repo root: daslang doom/REVIEW.das - exit 0 clean, 1 with findings.

[export]
def main : int {
    gate_untracked(["doom/fetch", "doom/work", "*.wad"], "doom/fetch/ and doom/work/ are regenerated by fetch.sh and run.das, and an IWAD is fetched or user-supplied: never committed")
    return gate_verdict("doom")
}
