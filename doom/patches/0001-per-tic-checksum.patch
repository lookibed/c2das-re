produces are distributed under the same license, WITHOUT ANY WARRANTY.

- g_game.c: with -DDOOM_TIC_CHECKSUM, G_Ticker ends by storing the tic it ran and its checksum,
  the 32-bit FNV-1a (offset basis 2166136261, prime 16777619) over the little-endian bytes of
  players[0].mo->x, y, z, angle (0 without a mobj), players[0].health and prndindex, the index
  P_Random steps.
- d_main.c: with the define, D_DoomLoop prints one line per game tic once D_Display has drawn
  it, "tic=<gametic> cs=<8 hex digits> fb=<8 hex digits>", fb the same FNV-1a over the bytes of
  screens[0]. Without the define the build prints nothing more.
- w_wad.c, r_data.c, i_video.c: a cached lump ends in 128 zero bytes, a composite texture is
  zeroed with the same slack, and the screen starts zeroed. A column drawer reads up to 127
  bytes past a column's start (a wall taller than its texture, a post's first row rounded to
  row -1 and wrapped to 127), which past a lump's end read the zone's next block header, so the
  frame of such a tic changed from run to run with the heap's addresses.
- d_main.c: -playdemo and -timedemo return from D_DoomMain after I_InitGraphics. PureDOOM's
  D_DoomLoop runs a single tic and returns, so the call vanilla never returns from fell through
  to the title loop (or, for a multiplayer demo, to G_InitNew), which replaced the demo.

diff --git a/src/DOOM/d_main.c b/src/DOOM/d_main.c
index 6cf98c8..806d465 100644
--- a/src/DOOM/d_main.c
+++ b/src/DOOM/d_main.c
@@ -331,6 +331,52 @@ void D_UpdateWipe(void)
 }
 
 
+#if defined(DOOM_TIC_CHECKSUM)
+extern int tic_checksum_tic;
+extern unsigned int tic_checksum_cs;
+
+// [c2das] "<key><8 hex digits>" through doom_print.
+static void D_PrintHex(const char* key, unsigned int value)
+{
+    static const char hex[] = "0123456789abcdef";
+    char digits[9];
+    int i;
+
+    for (i = 0; i < 8; i++)
+        digits[i] = hex[(value >> (28 - 4 * i)) & 0xf];
+    digits[8] = 0;
+    doom_print(key);
+    doom_print(digits);
+}
+
+//
+// D_TicChecksums
+// [c2das] One line per game tic once D_Display has drawn it, "tic=<gametic> cs=<8 hex digits>
+// fb=<8 hex digits>": G_Ticker's checksum of the tic, then the same FNV-1a over the bytes of
+// screens[0] as D_Display leaves it (at a wipe's start, the screen the melt starts from).
+//
+static void D_TicChecksums(void)
+{
+    unsigned int fb = 2166136261u;
+    int i;
+
+    if (tic_checksum_tic < 0)
+        return;
+    for (i = 0; i < SCREENWIDTH * SCREENHEIGHT; i++)
+    {
+        fb ^= screens[0][i];
+        fb *= 16777619u;
+    }
+    doom_print("tic=");
+    doom_print(doom_itoa(tic_checksum_tic, 10));
+    D_PrintHex(" cs=", tic_checksum_cs);
+    D_PrintHex(" fb=", fb);
+    doom_print("\n");
+    tic_checksum_tic = -1;
+}
+#endif
+
+
 void D_DoomLoop(void)
 {
 #if 0 // [pd] Moved to D_DoomMain()
@@ -375,6 +421,9 @@ void D_DoomLoop(void)
 
         // Update display, next frame, with current state.
         D_Display();
+#if defined(DOOM_TIC_CHECKSUM)
+        D_TicChecksums();
+#endif
 
 #if 0 // [pd] Sound is queried by the application's audio thread.
         // Sound mixing for the buffer is snychronous.
@@ -1196,14 +1245,20 @@ void D_DoomMain(void)
     {
         singledemo = true;              // quit after one demo
         G_DeferedPlayDemo(myargv[p + 1]);
-        D_DoomLoop();  // never returns
+        // [c2das] D_DoomLoop runs one tic here and returns, so the title loop below would
+        // replace the demo: the application's loop plays it from its first tic instead.
+        I_InitGraphics();
+        return;
     }
 
     p = M_CheckParm("-timedemo");
     if (p && p < myargc - 1)
     {
         G_TimeDemo(myargv[p + 1]);
-        D_DoomLoop();  // never returns
+        // [c2das] D_DoomLoop runs one tic here and returns, so the title loop below would
+        // replace the demo: the application's loop plays it from its first tic instead.
+        I_InitGraphics();
+        return;
     }
 
