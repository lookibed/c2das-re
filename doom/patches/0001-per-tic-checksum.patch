diff --git a/src/DOOM/g_game.c b/src/DOOM/g_game.c
index 01f68dd..2a0b634 100644
--- a/src/DOOM/g_game.c
+++ b/src/DOOM/g_game.c
@@ -603,6 +603,42 @@ doom_boolean G_Responder(event_t* ev)
 
 
 
+#if defined(DOOM_TIC_CHECKSUM)
+// [c2das] The tic G_Ticker ran last and its checksum, -1 until it runs one: D_DoomLoop prints
+// them with the frame's checksum once D_Display has drawn the tic.
+int tic_checksum_tic = -1;
+unsigned int tic_checksum_cs;
+
+//
+// G_TicChecksum
+// [c2das] The 32-bit FNV-1a over the little-endian bytes of players[0].mo->x, y, z, angle
+// (0 without a mobj), players[0].health and prndindex, the P_Random index.
+//
+static unsigned int G_TicChecksum(void)
+{
+    extern int prndindex;
+    mobj_t* mo = players[0].mo;
+    unsigned int values[6];
+    unsigned int cs = 2166136261u;
+    int i, b;
+
+    values[0] = mo ? (unsigned int)mo->x : 0;
+    values[1] = mo ? (unsigned int)mo->y : 0;
+    values[2] = mo ? (unsigned int)mo->z : 0;
+    values[3] = mo ? (unsigned int)mo->angle : 0;
+    values[4] = (unsigned int)players[0].health;
+    values[5] = (unsigned int)prndindex;
+    for (i = 0; i < 6; i++)
+        for (b = 0; b < 32; b += 8)
+        {
+            cs ^= (values[i] >> b) & 0xff;
+            cs *= 16777619u;
+        }
+    return cs;
+}
+#endif
+
+
 //
 // G_Ticker
 // Make ticcmd_ts for the players.
@@ -759,6 +795,10 @@ void G_Ticker(void)
             D_PageTicker();
             break;
     }
+#if defined(DOOM_TIC_CHECKSUM)
+    tic_checksum_cs = G_TicChecksum();
+    tic_checksum_tic = gametic;
+#endif
 }
 
 
