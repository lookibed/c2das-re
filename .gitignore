# daslang run artifacts: the JIT cache and the module cache land in the working directory of
# whatever ran (daScript ignores its own .cache/ the same way)
.jitted_scripts/
.cache/
*.aot.cpp
*.aot.h

# converted output and suite scratch never enter the tree (LAWS.md: repeatable pipeline)
/out/
/suites/*/fetch/
/suites/*/work/
/perf/work/
/compare/work/
/metrics/work/
/lua/fetch/
/lua/work/
/doom/fetch/
/doom/work/

# native glue module: build dirs, the built DLL and the descriptor manifest daslang writes
/dasCRuntime/_build/
/dasCRuntime/build/
**/compile_commands.json
*.shared_module
.das_module.manifest

# machine-local agent wiring (the tracked *.example files are the templates)
/.codex/*
!/.codex/config.toml.example
/.claude/settings.local.json
/opencode.json
/.env
/.claude/worktrees/

# diagnostics and benchmark scratch
/logs/
/libhv.*.log
__pycache__/

# editor and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*Zone.Identifier

# user-supplied game data: never committed
/doom/wads/*.wad
